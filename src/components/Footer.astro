---
import Mark from './Mark.astro';
import { PINTEREST_URL } from '../consts';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container grid">
    <div class="about">
      <a class="brand" href="/" aria-label="Shelf Made Home, home page"><Mark size={30} /><span class="wordmark">shelfmade <span>home</span></span></a>
      <p class="muted">Small kitchen organization ideas, pantry makeovers and storage inspiration.</p>
    </div>
    <nav aria-label="Footer">
      <ul>
        <li><a href="/ideas/">All ideas</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href={PINTEREST_URL} rel="me">Pinterest</a></li>
        <li><a href="/privacy-policy/">Privacy policy</a></li>
        <li><a href="/affiliate-disclosure/">Affiliate disclosure</a></li>
      </ul>
    </nav>
  </div>
  <div class="container legal">
    <p>As an Amazon Associate I earn from qualifying purchases.</p>
    <p>© {year} Shelf Made Home</p>
  </div>
</footer>

<style>
  .site-footer { margin-top: 120px; background: var(--ink); color: var(--paper); padding-block: 56px 32px; }
  .site-footer a { color: var(--paper); }
  .grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; }
  .wordmark { font-family: var(--font-display); font-weight: 700; font-size: 1.35rem; letter-spacing: -0.04em; }
  .wordmark span { font-weight: 400; color: var(--blue-light); }
  .about p { color: #C9CCD3; max-width: 36ch; margin-top: 14px; }
  ul { list-style: none; margin: 0; padding: 0; columns: 2; column-gap: 32px; }
  li { margin-bottom: 10px; }
  nav a { text-decoration: none; }
  nav a:hover { text-decoration: underline; }
  .legal { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-top: 44px; padding-top: 20px; border-top: 1px solid #3A3E47; font-size: 0.9rem; color: #C9CCD3; }
  .legal p { margin: 0; }
  @media (max-width: 720px) { .grid { grid-template-columns: 1fr; } }
</style>
