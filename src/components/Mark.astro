---
// The jar mark from the Pinterest profile logo.
interface Props { size?: number; title?: string }
const { size = 36, title } = Astro.props;
---
<svg width={size} height={Math.round(size * 0.87)} viewBox="130 200 540 470" xmlns="http://www.w3.org/2000/svg" role={title ? 'img' : undefined} aria-hidden={title ? undefined : 'true'} aria-label={title}>
  <rect x="250" y="290" width="300" height="320" rx="60" fill="#FAF8F4"/>
  <rect x="264" y="450" width="272" height="146" rx="46" fill="#3E64D6"/>
  <rect x="250" y="290" width="300" height="320" rx="60" fill="none" stroke="#16181D" stroke-width="28"/>
  <rect x="280" y="226" width="240" height="56" rx="18" fill="#F06A45"/>
  <rect x="150" y="624" width="500" height="24" rx="12" fill="#16181D"/>
</svg>
