---
import BaseLayout from './BaseLayout.astro';
interface Props { title: string; description?: string; updated?: string }
const { title, description, updated } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <section class="container page">
    <h1>{title}</h1>
    {updated && <p class="muted updated">Last updated {updated}</p>}
    <div class="prose"><slot /></div>
  </section>
</BaseLayout>
<style>
  .page { padding-top: 40px; }
  h1 { margin-bottom: 32px; font-size: clamp(2.3rem, 5vw, 3.6rem); }
  .updated { margin: -16px 0 32px; font-size: 0.95rem; }
</style>
